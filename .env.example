# =========================================================================
# AlertaCiudad Web - Variables de entorno (PLANTILLA - sin secretos reales)
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# =========================================================================

# Cadena de conexion a PostgreSQL (Neon). Formato:
# postgresql://USUARIO:PASSWORD@HOST/BASE?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/alertaciudad?sslmode=require"

# Secreto para firmar la cookie de sesion del portal admin.
# Genera uno con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
