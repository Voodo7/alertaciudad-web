# =========================================================================
# AlertaCiudad Web - Variables de entorno (PLANTILLA - sin secretos reales)
# Copia este archivo a .env y rellena los valores. NUNCA subas .env a git.
# =========================================================================

# Cadena de conexion a PostgreSQL (Neon). Formato:
# postgresql://USUARIO:PASSWORD@HOST/BASE?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/alertaciudad?sslmode=require"

# Secreto para firmar la cookie de sesion del portal admin.
# Genera uno con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# --- Firebase Admin (para escribir notificaciones en Firestore) ---
# Obtenlos del JSON de "Cuenta de servicio" de Firebase:
# Console -> Configuracion del proyecto -> Cuentas de servicio -> Generar nueva clave privada
FIREBASE_PROJECT_ID="alertaciudad"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@alertaciudad.iam.gserviceaccount.com"
# La clave privada COMPLETA entre comillas, con los \n literales (tal cual viene en el JSON).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
